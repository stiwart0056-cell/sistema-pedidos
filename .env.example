# Variables de Entorno - Mr. Toasted
# Copia este archivo a .env.local para desarrollo local
# En Vercel, configura estas variables en Settings → Environment Variables

# Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Nota: No incluyas la SERVICE KEY aquí. Solo usa la ANON KEY pública.
# La SERVICE KEY debe usarse solo en backend/edge functions.
